#!/bin/bash
# This script creates a new Alembic migration with the provided message. If no message is provided, it prompts the user for one.

if [ -z $1 ]; then
    read -p "Please provide a message for the migration: " MESSAGE
else
    MESSAGE="$@"
fi

echo "Creating migration..."
alembic revision --autogenerate -m "$MESSAGE" && \
    echo "Migration created successfully." || \
    { echo "Failed to create migration." ; exit 1; }